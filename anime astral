-- UNLOAD CLEANUP
-- ═══════════════════════════════════════════════════════════
Library:OnUnload(function()
    getgenv().AnimeAstral_Loaded = nil
    TaskManager:CleanupAll()

    -- Stop all auto features cleanly
    pcall(AutoActions.StopAutoHatch)
    pcall(AutoActions.StopAutoGacha)

    -- Turn off in-game auto toggles that we enabled
    if Toggles.AutoClick and Toggles.AutoClick.Value then
        pcall(AutoActions.SetAutoClick, false)
    end
    if Toggles.RangeMode and Toggles.RangeMode.Value then
        pcall(AutoActions.SetRange, false)
    end

    print("[AA] Cleanly unloaded")
end)

