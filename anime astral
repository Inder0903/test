            StatusLabels.level:SetText("Level: " .. tostring(d.Level or "?") .. " | Rank: " .. tostring(d.Rank or "?"))
            StatusLabels.power:SetText("Power: " .. string.format("%.2e", tonumber(d.Power) or 0))
            StatusLabels.yen:SetText("Yen: " .. string.format("%.2e", tonumber(d.Yen) or 0))
            StatusLabels.autoClick:SetText("Auto Click: " .. tostring(d.AutoClickState))
            StatusLabels.range:SetText("Range: " .. tostring(d.RangeState))

            -- Count active toggles
            local count = 0
            for name, tog in pairs(Toggles) do
                if tog.Value == true then count = count + 1 end
            end
            StatusLabels.activeTogs:SetText("Active Toggles: " .. count)
        end)
    end
end)

-- Auto claim loop (respects user interval)
TaskManager:AddLoop("AutoClaim", function()
    task.wait(5)  -- check every 5s
    if Toggles.AutoClaimLoop and Toggles.AutoClaimLoop.Value then
        local interval = Options.AutoClaimInterval and Options.AutoClaimInterval.Value or 60
        AutoActions.ClaimAllRewards()
        task.wait(interval)
    end
end)

-- Anti-AFK pulse (in addition to Idled connection)
TaskManager:AddLoop("AntiAfkPulse", function()
    task.wait(60)
    AutoActions.AntiAfkPulse()
end)

-- Watchdog: verify built-in toggles are still on
-- (in case game auto-disables them on world change, etc.)
TaskManager:AddLoop("ToggleWatchdog", function()
    task.wait(10)
    local d = GetData()
    if not d then return end

    -- Re-apply auto click if toggle is on but state is off
    if Toggles.AutoClick and Toggles.AutoClick.Value and not d.AutoClickState then
        AutoActions.SetAutoClick(true)
    end

    -- Re-apply range if toggle is on but state is off
    if Toggles.RangeMode and Toggles.RangeMode.Value and not d.RangeState then
        AutoActions.SetRange(true)
    end

    -- Re-apply settings that user has toggled
    for _, s in ipairs(settingsToggles) do
        local userToggle = Toggles["Setting_" .. s.key]
        if userToggle and userToggle.Value then
            local gameSetting = (d.Settings or {})[s.key]
            if gameSetting ~= userToggle.Value then
                AutoActions.SetSetting(s.key, userToggle.Value)
            end
        end
    end
end)

