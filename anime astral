-- ═══════════════════════════════════════════════════════════
-- SAFE CALL WRAPPER (isolates errors)
-- ═══════════════════════════════════════════════════════════
local function safeCall(fnDesc, fn, ...)
    if type(fn) ~= "function" then return nil end
    local ok, result = pcall(fn, ...)
    if not ok then
        warn("[AA] " .. fnDesc .. " failed: " .. tostring(result))
    end
    return ok and result or nil
end

-- ═══════════════════════════════════════════════════════════
-- CACHED DATA GETTER (prevents remote spam)
-- ═══════════════════════════════════════════════════════════
local _dataCache = { data = nil, time = 0 }
local DATA_CACHE_TTL = 1.5  -- seconds

local function GetData(forceFresh)
    if not GetPlayerData then return nil end
    local now = tick()
    if not forceFresh and _dataCache.data and (now - _dataCache.time) < DATA_CACHE_TTL then
        return _dataCache.data
    end
    local ok, data = pcall(function() return GetPlayerData:InvokeServer() end)
    if ok then
        _dataCache.data = data
        _dataCache.time = now
        return data
    end
    return _dataCache.data  -- fallback to stale
end

local function GetSettings()
    local data = GetData()
    return (data and data.Settings) or {}
end

-- ═══════════════════════════════════════════════════════════
-- TASK MANAGER (all loops registered here for cleanup)
-- ═══════════════════════════════════════════════════════════
local TaskManager = {
    threads = {},
    connections = {},
}

function TaskManager:AddLoop(name, fn)
    if self.threads[name] then return end
    self.threads[name] = task.spawn(function()
        while not Library.Unloaded do
            local ok, err = pcall(fn)
            if not ok then
                warn("[AA:" .. name .. "] loop error: " .. tostring(err))
                task.wait(1)  -- backoff on error
            end
        end
    end)
end

function TaskManager:AddConnection(conn)
    table.insert(self.connections, conn)
end

function TaskManager:CleanupAll()
    for _, conn in ipairs(self.connections) do
        pcall(function() conn:Disconnect() end)
    end
    self.connections = {}
    -- Threads auto-die when Library.Unloaded checked
end

-- ═══════════════════════════════════════════════════════════
-- RATE LIMITER (prevents remote spam)
-- ═══════════════════════════════════════════════════════════
local RateLimiter = {}
RateLimiter.__index = RateLimiter

function RateLimiter.new(cooldownSec)
    return setmetatable({ cooldown = cooldownSec, lastCall = 0 }, RateLimiter)
end

function RateLimiter:Try()
    local now = tick()
    if now - self.lastCall >= self.cooldown then
        self.lastCall = now
        return true
    end
    return false
end

