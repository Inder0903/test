local function BuildWorldList()
    local list = {}
    if Configs.World and Configs.World.GetAllWorlds then
        local ok, worlds = pcall(Configs.World.GetAllWorlds)
        if ok and type(worlds) == "table" then
            for id, w in pairs(worlds) do
                if type(w) == "table" then
                    table.insert(list, { id=id, name=w.Name or w.DisplayName or tostring(id) })
                end
            end
        end
    end
    table.sort(list, function(a, b) return tostring(a.id) < tostring(b.id) end)
    return list
end

local function BuildRaidList()
    local list = {}
    if Configs.Raid and Configs.Raid.GetAllRaids then
        local ok, raids = pcall(Configs.Raid.GetAllRaids)
        if ok and type(raids) == "table" then
            for id, r in pairs(raids) do
                if type(r) == "table" then
                    table.insert(list, { id=id, name=r.Name or r.DisplayName or tostring(id) })
                end
            end
        end
    end
    return list
end

local function BuildEggList()
    local list = {}
    if type(Configs.Eggs) == "table" then
        for worldKey, worldEggs in pairs(Configs.Eggs) do
            if type(worldEggs) == "table" then
                for eggKey, egg in pairs(worldEggs) do
                    if type(egg) == "table" then
                        table.insert(list, {
                            key = eggKey,
                            world = worldKey,
                            name = egg.Name or egg.DisplayName or eggKey,
                        })
                    end
                end
            end
        end
    end
    table.sort(list, function(a, b) return a.name < b.name end)
    return list
end

