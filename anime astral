local AutoActions = {}

function AutoActions.SetAutoClick(enable)
    local c = Controllers.AutoClick
    if not c then return end
    local isActive = safeCall("IsAutoClickActive", c.IsAutoClickActive) == true
    if enable ~= isActive then
        safeCall("AutoClick.Toggle", c.Toggle)
    end
end

function AutoActions.SetRange(enable)
    local c = Controllers.Range
    if not c then return end
    if c.SetActive then
        safeCall("Range.SetActive", c.SetActive, enable)
    elseif c.Toggle and c.IsActive then
        local isActive = safeCall("Range.IsActive", c.IsActive) == true
        if enable ~= isActive then
            safeCall("Range.Toggle", c.Toggle)
        end
    end
end

function AutoActions.SetSetting(key, value)
    if Controllers.Settings and Controllers.Settings.SetSetting then
        safeCall("SetSetting:" .. key, Controllers.Settings.SetSetting, key, value)
    end
end

function AutoActions.StartAutoHatch(eggKey)
    local c = Controllers.PetRoll
    if not c then return end
    if eggKey and c.SetCurrentEggKey then
        safeCall("SetCurrentEggKey", c.SetCurrentEggKey, eggKey)
    end
    safeCall("StartAutoOpen", c.StartAutoOpen)
end

function AutoActions.StopAutoHatch()
    if Controllers.PetRoll then
        safeCall("StopAutoOpen", Controllers.PetRoll.StopAutoOpen)
    end
end

function AutoActions.SingleHatch()
    if Controllers.PetRoll and Controllers.PetRoll.OpenEgg then
        safeCall("OpenEgg", Controllers.PetRoll.OpenEgg)
    end
end

function AutoActions.StartAutoGacha()
    if Controllers.Gacha then
        safeCall("StartAutoRoll", Controllers.Gacha.StartAutoRoll)
    end
end

function AutoActions.StopAutoGacha()
    if Controllers.Gacha then
        safeCall("StopAutoRoll", Controllers.Gacha.StopAutoRoll)
    end
end

function AutoActions.SingleGacha()
    if Controllers.Gacha and Controllers.Gacha.FireAndAwaitRoll then
        safeCall("FireAndAwaitRoll", Controllers.Gacha.FireAndAwaitRoll)
    end
end

function AutoActions.SetAutoRaidStart(v)
    if Controllers.Raid and Controllers.Raid.SetAutoStart then
        safeCall("SetAutoStart", Controllers.Raid.SetAutoStart, v)
    end
end
function AutoActions.SetAutoRaidArise(v)
    if Controllers.Raid and Controllers.Raid.SetAutoArise then
        safeCall("SetAutoArise", Controllers.Raid.SetAutoArise, v)
    end
end
function AutoActions.SetAutoBossRush(v)
    if Controllers.BossRush and Controllers.BossRush.SetAutoStart then
        safeCall("BossRush.SetAutoStart", Controllers.BossRush.SetAutoStart, v)
    end
end
function AutoActions.SetAutoBossRushFinger(v)
    if Controllers.BossRush and Controllers.BossRush.SetAutoCollectFinger then
        safeCall("SetAutoCollectFinger", Controllers.BossRush.SetAutoCollectFinger, v)
    end
end

function AutoActions.RedeemCode(code)
    if Controllers.Codes and Controllers.Codes.Redeem then
        return safeCall("Redeem", Controllers.Codes.Redeem, code)
    end
end

function AutoActions.ClaimAllRewards()
    local r = Controllers.Rewards
    if not r then return end
    if r.ClaimAll              then safeCall("ClaimAll", r.ClaimAll) end
    if r.ClaimAllDailyRewards  then safeCall("ClaimAllDailyRewards", r.ClaimAllDailyRewards) end
    if r.ClaimAllTimeRewards   then safeCall("ClaimAllTimeRewards", r.ClaimAllTimeRewards) end
end

function AutoActions.AntiAfkPulse()
    if Controllers.AntiAfk and Controllers.AntiAfk.Pulse then
        safeCall("AntiAfk.Pulse", Controllers.AntiAfk.Pulse)
    end
end

